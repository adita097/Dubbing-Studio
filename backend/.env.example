# ==============================================================================
# DubStudio Environment Configuration
# ==============================================================================

# API Keys (leave blank or use dummy value if MOCK_AI_MODE=true)
OPENAI_API_KEY=your_openai_api_key_here

# Provider Configuration
# Supported translation providers: "openai", "mock"
TRANSLATION_PROVIDER=mock
TRANSLATION_API_KEY=

# Supported speech/TTS providers: "openai", "mock"
SPEECH_PROVIDER=mock
SPEECH_API_KEY=

# Set to true for full local testing without real API calls or costs
MOCK_AI_MODE=true

# Server & Security
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Media & Upload Constraints
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=1800
MAX_CONCURRENT_JOBS=3

# Storage Directory (relative to backend or absolute path)
STORAGE_DIR=storage

# Optional: Path to ffmpeg and ffprobe executables if not in system PATH
FFMPEG_PATH=
FFPROBE_PATH=
